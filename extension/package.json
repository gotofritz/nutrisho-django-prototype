{
  "name": "nutrisho-clipper",
  "version": "0.1.0",
  "private": true,
  "description": "Clip a recipe from the page you are reading into your Nutrisho.",
  "license": "0BSD",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=25",
    "pnpm": ">=10.33.0"
  },
  "scripts": {
    "dev": "wxt -b firefox",
    "dev:chrome": "wxt -b chrome",
    "preview": "vite --config preview/vite.config.ts",
    "preview:build": "vite build --config preview/vite.config.ts",
    "build": "wxt build -b firefox",
    "build:chrome": "wxt build -b chrome",
    "zip": "wxt zip -b firefox",
    "zip:chrome": "wxt zip -b chrome",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "lint": "eslint .",
    "lint:amo": "web-ext lint --self-hosted --source-dir .output/firefox-mv3",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "26.6.7",
    "@vitest/coverage-v8": "4.1.11",
    "@wxt-dev/module-svelte": "2.0.5",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.2.0",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "4.1.11",
    "web-ext": "10.8.0",
    "wxt": "0.21.5"
  }
}
