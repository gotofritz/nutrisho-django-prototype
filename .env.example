# Copy to .env and fill in values
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=sqlite:///db.sqlite3
# LOG_LEVEL=INFO
# Optional error reporting; leave unset to disable Sentry
# SENTRY_DSN=

# Owner account for `uv run poe bootstrap`. Leave blank to be prompted.
# There are no defaults: pick a strong password, never reuse one.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
