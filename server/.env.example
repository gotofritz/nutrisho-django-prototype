# Copy to .env and fill in values
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=sqlite:///db.sqlite3
# LOG_LEVEL=INFO
# The clipper's JSON API (#149): idle days before a key expires (0: never),
# requests a minute per key, wrong keys a minute per address, and what one
# save may bring
# API_TOKEN_IDLE_DAYS=90
# API_REQUESTS_PER_MINUTE=60
# API_FAILED_KEYS_PER_MINUTE=20
# API_MAX_RECIPES=20
# API_MAX_NEW_NAMES=150
# Optional error reporting; leave unset to disable Sentry
# SENTRY_DSN=

# Owner account for `make bootstrap`. Leave blank to be prompted.
# There are no defaults: pick a strong password, never reuse one.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
